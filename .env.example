# Cross-device sync. Both are safe to expose: the anon key is designed to be
# public, and every policy on the `libraries` table is scoped to auth.uid().
# Never put the service_role key here — it bypasses RLS.
#
# Leave these unset and the app runs exactly as before, local-only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
