# Cross-device sync. Safe to expose: the Data API endpoint is public by design,
# and every policy on the sync tables is scoped to auth.user_id(), the signed-in
# account. Never put a Postgres connection string here — it is an owner
# credential and bypasses RLS.
#
# Leave this unset and the app runs exactly as before, local-only.
VITE_NEON_BASE_URL=https://<endpoint>.<region>.aws.neon.tech/neondb
