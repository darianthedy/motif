default_platform(:ios)

XCODEPROJ      = "Motif.xcodeproj"
SCHEME         = "Motif"
APP_IDENTIFIER = "com.dthedy.Motif"
TEAM_ID        = "F73L2977Q8"
PROFILE_NAME   = "match AppStore #{APP_IDENTIFIER}"

# Build an App Store Connect API key from CI env vars. Used for both signing
# (match) and uploading (TestFlight), so no Apple ID password / 2FA is needed.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: true,
    in_house: false
  )
end

platform :ios do
  # Creates a temporary keychain and tweaks settings so match/codesign work
  # on an ephemeral CI runner. No-op when run locally.
  before_all do
    setup_ci
  end

  desc "Build the Release app and upload it to TestFlight"
  lane :beta do
    api_key = asc_api_key

    # Fetch (or, on first run, create) the App Store provisioning profile for
    # this bundle ID — the distribution cert is shared with Financial
    # Management — and install them into the CI keychain.
    #
    # `setup_ci` (before_all) force-sets MATCH_READONLY=true on macOS CI so
    # builds never accidentally mint duplicate signing assets. That also blocks
    # the FIRST run, which legitimately must CREATE the profile and store it in
    # the match repo. So we gate creation on our own variable that setup_ci
    # doesn't touch: set repo Variable MATCH_CREATE_CERTS=true for the first
    # successful run, then delete it.
    create_certs = ENV["MATCH_CREATE_CERTS"] == "true"

    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
      readonly: !create_certs
    )

    # Apply manual signing to the APP TARGET ONLY. Passing CODE_SIGN_IDENTITY /
    # PROVISIONING_PROFILE_SPECIFIER globally via xcargs forces them onto every
    # target — including Swift Package dependencies (ChessKit) that don't
    # support provisioning profiles, which fails the archive. Editing the
    # project's signing settings scopes them to just our target. (Edits the CI
    # checkout's pbxproj; not committed — Debug keeps automatic signing.)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      targets: [SCHEME],
      team_id: TEAM_ID,
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE_NAME
    )

    # Give every CI build a unique, increasing build number. The project uses
    # GENERATE_INFOPLIST_FILE, so CURRENT_PROJECT_VERSION drives the build
    # number; passing it via xcargs avoids editing tracked files.
    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")

    # The Neon base URL. Config/Base.xcconfig leaves it empty (Local.xcconfig is
    # git-ignored), and an empty value means the in-memory dev backend — so a
    # TestFlight build without it would silently keep data on the phone only.
    # ENV.fetch fails the build instead, as the Pages deploy does.
    neon_base_url = ENV.fetch("NEON_BASE_URL")
    UI.user_error!("NEON_BASE_URL is empty") if neon_base_url.strip.empty?

    ipa_path = build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { APP_IDENTIFIER => PROFILE_NAME }
      },
      xcargs: [
        "-allowProvisioningUpdates",
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "NEON_BASE_URL=#{neon_base_url.shellescape}"
      ].join(" "),
      output_directory: "build",
      output_name: "Motif.ipa"
    )

    # The Stockfish nets are fetched, not committed; never upload a build
    # that's missing one (scripts/fetch-nnue.sh holds their names).
    sh(File.expand_path("../../../scripts/fetch-nnue.sh", __dir__), "--check-ipa", ipa_path)

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      distribute_external: false # internal testers get it as soon as Apple finishes processing
    )
  end

  desc "Run the unit and UI tests on a simulator (no signing)"
  lane :test do
    run_tests(
      project: XCODEPROJ,
      scheme: SCHEME,
      device: ENV["IOS_SIMULATOR_NAME"] || "iPhone 17",
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end
end
